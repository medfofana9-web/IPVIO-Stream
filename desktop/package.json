{
  "name": "fof-tv-desktop",
  "productName": "Fof TV",
  "version": "0.6.1",
  "description": "Fof TV for Mac - your Fof TV account, profiles, addons and playlist on the desktop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac zip --x64 --arm64 --publish never"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.7.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fof.tv.desktop",
    "productName": "Fof TV",
    "artifactName": "FofTV-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "dlna.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/icon.png",
      "target": [
        "zip"
      ],
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Fof TV finds the smart TVs on your Wi-Fi (Samsung, LG, Sony) so it can play on them.",
        "NSBonjourServices": [
          "_airplay._tcp",
          "_googlecast._tcp"
        ]
      }
    },
    "dmg": {
      "title": "Fof TV",
      "backgroundColor": "#000000"
    },
    "publish": null
  },
  "repository": "https://github.com/medfofana9-web/IPVIO-Stream",
  "shell": 8
}
