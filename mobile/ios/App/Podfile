# VLC for .mkv / .avi on the iPhone (Apple's player cannot open them). Capacitor itself comes through Swift Package
# Manager (CapApp-SPM); only VLC comes from CocoaPods.
platform :ios, '15.0'
target 'App' do
  use_frameworks!
  pod 'MobileVLCKit', '~> 3.6'
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each { |c| c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0' }
  end
end
